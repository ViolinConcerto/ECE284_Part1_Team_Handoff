# Vanilla reference corelet only; this project has not been compiled in Quartus.
set_global_assignment -name FAMILY "Cyclone IV GX"
set_global_assignment -name DEVICE EP4CGX150DF31I7AD
set_global_assignment -name TOP_LEVEL_ENTITY corelet
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SEED 1
set_global_assignment -name SDC_FILE vanilla_corelet.sdc

# Parse the existing .v sources as SystemVerilog, including explicit unsigned ports.
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/mac.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/mac_tile.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/mac_row.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/mac_array.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/l0.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/ofifo.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/fifo_depth64.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/fifo_mux_2_1.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/fifo_mux_8_1.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/fifo_mux_16_1.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/sfp.v
set_global_assignment -name SYSTEMVERILOG_FILE ../reference_dut/corelet.v

# No VCD/SAF overrides: unspecified input data activity is 20% of its clock rate.
set_global_assignment -name POWER_USE_INPUT_FILES OFF
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE "20%"
set_global_assignment -name POWER_REPORT_SIGNAL_ACTIVITY ON
